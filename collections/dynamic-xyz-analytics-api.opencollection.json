          },
          "http": {
            "method": "GET",
            "url": "https://app.dynamicauth.com/api/v0/environments/:environmentId/analytics/wallets",
            "params": [
              {
                "name": "environmentId",
                "value": "",
                "type": "path",
                "description": "ID of the environment"
              },
              {
                "name": "startDate",
                "value": "",
                "type": "query"
              },
              {
                "name": "endDate",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Fetch wallets breakdown"
