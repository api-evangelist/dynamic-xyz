      "items": [
        {
          "info": {
            "name": "Get all custom networks for an organization",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.dynamicauth.com/api/v0/organizations/:organizationId/customNetworks",
            "params": [
              {
                "name": "organizationId",
                "value": "",
                "type": "path",
                "description": "ID of organization"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get all custom networks for an organization"
        },
        {
