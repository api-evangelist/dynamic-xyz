{
  "opencollection": "1.0.0",
  "info": {
    "name": "Dashboard Allowlists Members API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Members",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Delegate ownership of an organization to another admin. If successful, the previous owner becomes an admin.",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://app.dynamicauth.com/api/v0/members/:memberId/delegateOwnership",
            "params": [
              {
                "name": "memberId",
                "value": "",
                "type": "path",
                "description": "ID of the membership"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delegate ownership of an organization to another admin. If successful, the previous owner becomes an admin."
        },
        {
          "info": {
            "name": "Update a given members role",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://app.dynamicauth.com/api/v0/members/:memberId",
            "params": [
              {
                "name": "memberId",
                "value": "",
                "type": "path",
                "description": "ID of the membership"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update a given members role"
        },
        {
          "info": {
            "name": "Delete user membership from being an admin of an organization",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://app.dynamicauth.com/api/v0/members/:memberId",
            "params": [
              {
                "name": "memberId",
                "value": "",
                "type": "path",
                "description": "ID of the membership"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete user membership from being an admin of an organization"
        },
        {
          "info": {
            "name": "Get all users that are admins for an organization",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.dynamicauth.com/api/v0/organizations/:organizationId/members",
            "params": [
              {
                "name": "organizationId",
                "value": "",
                "type": "path",
                "description": "ID of organization"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get all users that are admins for an organization"
        },
        {
          "info": {
            "name": "Get Membership Environment IDs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.dynamicauth.com/api/v0/membershipEnvironmentIds",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieve the list of project environments that the user is a member of."
        }
      ]
    }
  ],
  "bundled": true
}