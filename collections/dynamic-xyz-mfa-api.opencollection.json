{
  "opencollection": "1.0.0",
  "info": {
    "name": "Dashboard Allowlists Mfa API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Mfa",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Delete all MFA Devices for the user",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://app.dynamicauth.com/api/v0/users/:userId/mfa",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path",
                "description": "UUID of the user"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete all MFA Devices for the user"
        },
        {
          "info": {
            "name": "Reset the user's MFA methods",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.dynamicauth.com/api/v0/users/:userId/mfa/reset",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path",
                "description": "UUID of the user"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Reset the user's MFA methods"
        }
      ]
    }
  ],
  "bundled": true
}