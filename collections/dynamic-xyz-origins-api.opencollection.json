            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.dynamicauth.com/api/v0/environments/:environmentId/origins",
            "params": [
              {
                "name": "environmentId",
                "value": "",
                "type": "path",
                "description": "ID of the environment"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Adds an allowed origin for this project environment"
        },
        {
          "info": {
            "name": "Delete a origin by id",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://app.dynamicauth.com/api/v0/origins/:originId",
            "params": [
              {
                "name": "originId",
                "value": "",
                "type": "path",
                "description": "ID of the origin"
              }
            ],
            "auth": {
              "type": "bearer",
