{
  "opencollection": "1.0.0",
  "info": {
    "name": "Dashboard Allowlists UserApiTokens API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "UserApiTokens",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get all API Tokens for Dashboard User",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.dynamicauth.com/api/v0/user/tokens",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get all API Tokens for Dashboard User"
        },
        {
          "info": {
            "name": "Create a new API Token for Dashboard User",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.dynamicauth.com/api/v0/user/tokens",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a new API Token for Dashboard User"
        },
        {
          "info": {
            "name": "Delete a API token by token id",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://app.dynamicauth.com/api/v0/user/tokens/:tokenId",
            "params": [
              {
                "name": "tokenId",
                "value": "",
                "type": "path",
                "description": "ID of the token"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete a API token by token id"
        }
      ]
    }
  ],
  "bundled": true
}